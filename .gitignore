/target
detector_output/

# viz.html itself is checked in (dev tooling); the viewer files it fetches
# live beside each dataset's own source `.osm`, are regeneratable build
# artifacts (see viz/README.md).
/data/*/zones.vehicles.geojson
/data/*/zones.pedestrians.geojson
/data/*/zones.programs.json
/data/*/net.geojson
/data/fixture/
# The neutral compiled map, its engine units and the republished client
# catalogue, written by `map-compile` (see integration_test/promote.sh).
/data/*/*.map.json
/data/*/engine-units/
/data/*/*.published.geojson
/viz/server.log
/viz/fixtures/
/viz/__pycache__/
